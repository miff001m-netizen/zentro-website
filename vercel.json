{
  "version": 2,
  "builds": [
    { "src": "dashboard.html", "use": "@vercel/static" },
    { "src": "top100.html", "use": "@vercel/static" },
    { "src": "transfers.html", "use": "@vercel/static" },
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/dashboard(/|[.]html)?", "dest": "/dashboard.html" },
    { "src": "/top100", "dest": "/top100.html" },
    { "src": "/transfers", "dest": "/transfers.html" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}