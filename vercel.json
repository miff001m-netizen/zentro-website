{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "*.html"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/:page(dashboard|profile|wallet|bank|transfers|leaderboard|achievements|settings|top100)", "destination": "/api/index.js" }
  ]
}
