{
  "version": 2,
  "functions": {
    "server.js": { "includeFiles": "*.{html,css,js,svg,webmanifest}" },
    "api/index.js": { "includeFiles": "*.{html,css,js,svg,webmanifest}" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/top100", "destination": "/top100.html" },
    { "source": "/transfers", "destination": "/transfers.html" },
    { "source": "/store", "destination": "/store.html" }
  ]
}
